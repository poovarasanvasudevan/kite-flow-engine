{
  "name": "wflow-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "bun --bun vite --host 127.0.0.1",
    "build": "tsc --noEmit && bun --bun vite build",
    "start": "bun src/server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/radio-canada": "^5.3.0",
    "@xyflow/react": "^12.9.2",
    "ace-builds": "^1.44.0",
    "html-to-image": "1.11.11",
    "imapflow": "^2.2.1",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.33",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "openai": "^7.28.0",
    "react": "^19.2.0",
    "react-ace": "^15.0.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
